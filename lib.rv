// raven-table: render rows as an aligned text table.
//
//     from "github.com/martian56/raven-table" import Table
//
//     let t = Table.new(["Name", "Age", "City"])
//     t.row(["Alice", "30", "New York"])
//     t.row(["Bob", "25", "Boston"])
//     print(t.render())
//
// Columns are sized to their widest cell. The header is bold by default (via
// raven-color); call `.plain()` for output without escapes, which is what you
// want for a file or a pipe.

import std.string
from "github.com/martian56/raven-color" import Style

class Table {
    headers: list[str]
    rows: list[list[str]]
    colored: bool
}

impl Table {
    // A table with the given column headers, colored output on.
    fun new(headers: list[str]) -> Table {
        let r: list[list[str]] = []
        return Table(headers: headers, rows: r, colored: true)
    }

    // A copy that renders without color (no escape codes).
    fun plain(self) -> Table {
        return Table(headers: self.headers, rows: self.rows, colored: false)
    }

    // Append a row. Short rows are padded with empty cells when rendered.
    fun row(self, cells: list[str]) -> Table {
        self.rows.push(cells)
        return self
    }

    // Render the table to a string: a bold header, a dashed rule, then the rows.
    fun render(self) -> str {
        let cols = self.headers.len()
        let widths: list[int] = []
        var c = 0
        while c < cols {
            widths.push(self.headers[c].length())
            c += 1
        }
        var r = 0
        while r < self.rows.len() {
            var j = 0
            while j < cols {
                let w = _cell(self.rows[r], j).length()
                if w > widths[j] {
                    widths[j] = w
                }
                j += 1
            }
            r += 1
        }

        var header = _format_row(self.headers, widths)
        if self.colored {
            header = Style.new().bold().apply(header)
        }

        let rule_cells: list[str] = []
        var k = 0
        while k < cols {
            rule_cells.push("-".repeat(widths[k]))
            k += 1
        }
        var out = "${header}\n${_format_row(rule_cells, widths)}"

        var i = 0
        while i < self.rows.len() {
            out = "${out}\n${_format_row(self.rows[i], widths)}"
            i += 1
        }
        return out
    }
}

// The cell at column `j`, or "" when the row is short.
fun _cell(row: list[str], j: int) -> str {
    if j < row.len() {
        return row[j]
    }
    return ""
}

// Join `cells` padded to `widths`, two spaces between columns. The last column
// is not padded, so lines carry no trailing whitespace.
fun _format_row(cells: list[str], widths: list[int]) -> str {
    var out = ""
    let last = widths.len() - 1
    var j = 0
    while j < widths.len() {
        if j > 0 {
            out = out.concat("  ")
        }
        let cell = _cell(cells, j)
        if j == last {
            out = out.concat(cell)
        } else {
            out = out.concat(_pad(cell, widths[j]))
        }
        j += 1
    }
    // A short row leaves a trailing separator before its empty last cell; drop
    // it so no line carries trailing whitespace.
    return out.trim_end()
}

fun _pad(s: str, width: int) -> str {
    let n = width - s.length()
    if n <= 0 {
        return s
    }
    return s.concat(" ".repeat(n))
}
